# Configure these in Render Dashboard > Environment. Never commit real secrets.
ADMIN_IDS=123456789
BOT_TOKEN=123456789:replace_with_botfather_token
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?appName=Cluster0
# Optional: keep this bot's quota collection in its own database (recommended).
MONGODB_DATABASE=animated_text_creator
# Optional: only set if the working URI used by your other bot specifies a custom authSource.
# MONGODB_AUTH_SOURCE=admin
