DASHBOARD_USERNAME=owner
DASHBOARD_PASSWORD=replace-with-a-long-random-password

# Generate one long random secret and set the SAME value on this service, Z28, and Admin Bot.
# Never commit the real secret. Management controls stay unavailable until this is configured.
CONTROL_CENTER_API_TOKEN=replace-with-the-same-long-random-secret-on-all-services

Z28_HEALTH_URL=https://z28-telegram-attendance-bot-pcs8.onrender.com/api/healthz
ADMIN_BOT_HEALTH_URL=https://admin-bot-uvy8.onrender.com/healthz
Z28_CONTROL_CENTER_URL=https://z28-telegram-attendance-bot-pcs8.onrender.com/api/control-center
ADMIN_BOT_CONTROL_CENTER_URL=https://admin-bot-uvy8.onrender.com/control-center
HEALTH_CHECK_TIMEOUT=8
