# Telegram bot token from @BotFather. Keep it private.
BOT_TOKEN=replace_with_botfather_token
# MongoDB Atlas connection string. Never commit real credentials.
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=schedule_bot
# Comma-separated Telegram user IDs allowed to open the Owner Panel.
ADMIN_IDS=123456789
# Scheduler polling interval (15–300 seconds; default 60).
SCHEDULER_INTERVAL_SECS=60
# Render supplies PORT automatically. Use 8080 for local development.
PORT=8080
