# Telegram BotFather token. Keep this secret.
BOT_TOKEN=replace_with_botfather_token

# Required persistent metadata database. Use your MongoDB Atlas connection string.
# Never commit the real URI or credentials.
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=emoji_rebuilder

# Render sets RENDER_EXTERNAL_URL automatically. For local webhook tests, set a public HTTPS URL.
# If PUBLIC_BASE_URL is empty and RENDER_EXTERNAL_URL is unavailable, the bot uses local long polling.
PUBLIC_BASE_URL=
# Optional; if empty, the app generates a random webhook secret at startup.
WEBHOOK_SECRET=

# Telegram Bot API downloads are limited to 20 MiB by this app.
MAX_DOWNLOAD_BYTES=20971520

# Optional outline font path for vector-text reconstruction (Unicode coverage depends on font).
# TEMPLATE_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
